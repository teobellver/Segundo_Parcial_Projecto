int flanco(void){
	static int fsi=0;
	int salida=-1;
	int s1=Inputs(IN0);
	if (!fsi && s1){
		fsi=1;
		 salida=1;
	}
	if (fsi && !s1){
		fsi=0;
		salida=0;
	}
	return salida;
}
void MDE(void){
